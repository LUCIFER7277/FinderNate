# ==========================================================================
# FinderNate Backend — environment template
# Copy to `.env` and fill in the values. `.env` is gitignored.
#   cp .env.example .env
# ==========================================================================

# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (MongoDB) ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/findernate

# ── JWT auth ────────────────────────────────────────────────────────────────
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

# ── Redis (caching, socket.io adapter, BullMQ queues) ───────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Public URLs ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:4000
BACKEND_URL=http://localhost:3000
ADDITIONAL_CORS_ORIGINS=

# ── Email (Nodemailer / Gmail app password) ─────────────────────────────────
EMAIL_USER=
EMAIL_PASS=

# ── SMS / OTP (Fast2SMS) ────────────────────────────────────────────────────
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_PASSWORD_RESET_VERIFICATION_TEMPLATE_ID=
FAST2SMS_PHONE_NUMBER_VERIFICATION_TEMPLATE_ID=

# ── Payments: Razorpay ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Payments: Cashfree ──────────────────────────────────────────────────────
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_PRIVATE_KEY=

# ── Payments: PhonePe ───────────────────────────────────────────────────────
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ── Stream (getstream.io — chat / video calling) ────────────────────────────
STREAM_API_KEY=
STREAM_API_SECRET=

# ── Bunny.net (media storage + CDN) ─────────────────────────────────────────
BUNNY_STORAGE_ZONE_NAME=
BUNNY_ACCESS_KEY=
BUNNY_STORAGE_API_URL=https://storage.bunnycdn.com
BUNNY_CDN_URL=https://findernate-media.b-cdn.net

# ── Firebase Admin (FCM push) — private key on one line with \n escapes ─────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Web Push (VAPID — `npx web-push generate-vapid-keys`) ───────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Misc / optional ─────────────────────────────────────────────────────────
INSTANCE_ID=local-1
ENABLE_MORGAN=true
DEBUG_CHAT=false
