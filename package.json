{
  "name": "findernate-backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "nodemon --exec tsx src/index.js",
    "start": "node dist/index.js",
    "start:cluster": "pm2-runtime start ecosystem.config.cjs --env production",
    "build": "tsc",
    "db:indexes": "tsx src/scripts/createIndexes.ts",
    "db:indexes:list": "tsx -e \"import('./src/scripts/createIndexes.ts').then(m => m.listExistingIndexes())\"",
    "seed:orders": "tsx src/scripts/seedTestOrders.ts",
    "clean:orders": "tsx src/scripts/cleanTestOrders.ts",
    "transfer:orders": "tsx src/scripts/transferOrders.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs findernate-backend",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit"
  },
  "author": "",
  "license": "ISC",
  "keywords": [
    "social-media",
    "backend",
    "express",
    "mongodb"
  ],
  "description": "Backend API for FinderNate social media application",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@stream-io/node-sdk": "^0.7.15",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^13.6.0",
    "form-data": "^4.0.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "md-to-pdf": "^5.2.4",
    "mongodb": "^6.17.0",
    "mongoose": "^8.16.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/mongoose": "^5.11.96",
    "@types/node": "^25.3.5",
    "nodemon": "^3.1.10",
    "pm2": "^6.0.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
